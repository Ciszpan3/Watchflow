# Szablon konfiguracji backendu. Skopiuj ten plik do backend/.env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Wymagane dla trybu live. Utwórz lokalną bazę PostgreSQL o nazwie watchflow.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watchflow

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
YOUTUBE_API_KEY=

# Wygeneruj 32 losowe bajty w base64. Klucz szyfruje refresh tokeny Google.
TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=watchflow_session
SESSION_TTL_DAYS=30
SYNC_CACHE_HOURS=6
SYNC_COOLDOWN_MINUTES=15
SEARCH_CACHE_HOURS=12
SEARCH_DAILY_LIMIT=80

# Opcjonalne: przewidziane dla przyszłych rekomendacji i podsumowań AI.
OPENAI_API_KEY=
